  "private": true,
  "scripts": {
    "test": "node scripts/test.cjs",
    "solve": "tsc scripts/solve.ts --outDir .cache/hanoi-playback --module commonjs --target es2019 --strict --skipLibCheck --sourceMap --inlineSources && node --enable-source-maps .cache/hanoi-playback/scripts/solve.js",
